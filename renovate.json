{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["every weekend"],
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "groupName": "all dependencies",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchPackageNames": ["roundcube/roundcubemail"],
      "allowedVersions": "1.6.x"
    }
  ],
  "docker-compose": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/test/**",
      "**/__fixtures__/**",
      "**/.mise/locks/**",
      "**/.config/mise/locks/**"
    ]
  },
  "pip_requirements": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/test/**",
      "**/__fixtures__/**",
      "**/.mise/locks/**",
      "**/.config/mise/locks/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/webmails\\/Dockerfile$/"],
      "matchStrings": ["ENV ROUNDCUBE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "roundcube/roundcubemail",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/webmails\\/Dockerfile$/"],
      "matchStrings": ["ENV CARDDAV_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "mstilkerich/rcmcarddav",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/webmails\\/Dockerfile$/"],
      "matchStrings": ["ENV SNAPPYMAIL_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "the-djmaze/snappymail",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": ["ghcr\\.io/renovatebot/renovate:(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/core/base/Dockerfile$/"],
      "matchStrings": ["ARG SNUFFLEUPAGUS_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "jvoisin/snuffleupagus",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
